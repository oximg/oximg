---
import CopyCommand from "./CopyCommand.astro";
import PipelineTrace from "./PipelineTrace.astro";
---

<section class="hero">
  <div class="container layout">
    <div class="copy">
      <p class="badge mono">
        <span class="pulse" aria-hidden="true"></span> v0.11 · experimental
      </p>
      <h1>
        Image resizing that's faster —<br />
        <span class="brand">and sharper.</span>
      </h1>
      <p class="lede">
        A Rust image server, CLI and library for JPEG, PNG, WebP and AVIF. It leads the PNG,
        WebP and AVIF cells of imgproxy's own benchmark, resizing in linear light at measurably
        higher quality.
      </p>
      <CopyCommand command="docker run -p 8081:8081 -v $PWD/images:/images:ro ghcr.io/oximg/oximg" />
      <div class="actions">
        <a class="btn btn-primary" href="#benchmarks">See the benchmarks</a>
        <a class="btn" href="https://github.com/oximg/oximg#install">Install guide</a>
      </div>
    </div>
    <PipelineTrace />
  </div>
</section>

<style>
  .hero {
    padding-block: var(--space-24) var(--space-16);
    background: radial-gradient(60rem 30rem at 85% 0%, rgb(232 98 44 / 0.08), transparent 70%);
  }
  .layout {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr);
    gap: var(--space-16);
    align-items: center;
  }
  .copy {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-6);
    min-width: 0;
  }
  .badge {
    justify-self: start;
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-1) var(--space-3);
    border: 1px solid var(--line-strong);
    border-radius: 999px;
    font-size: var(--step--1);
    color: var(--text-muted);
  }
  .pulse {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--accent);
    box-shadow: 0 0 0 3px var(--accent-soft);
  }
  h1 {
    font-size: var(--step-4);
    letter-spacing: -0.035em;
  }
  .brand {
    color: var(--brand);
  }
  .lede {
    font-size: var(--step-1);
    color: var(--text-muted);
    max-width: 36rem;
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }
  @media (max-width: 960px) {
    .layout {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
