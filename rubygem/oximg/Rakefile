# frozen_string_literal: true

require "rake/testtask"

Rake::TestTask.new(:test) do |t|
  t.libs = %w[lib test]
  t.test_files = FileList["test/**/*_test.rb"]
  t.warning = true
end

# The probe library a platform gem bundles (ext/), built into the
# repo's target/oximg-probe/release/ where the tests look for it.
# Release, as it ships: the tests compare its answers with the
# executable's. ext/build.sh is the one recipe, shared with CI and the
# release, and says why it is built the way it is.
desc "Build the in-process probe library from ext/"
task :compile do
  sh "sh", File.join(__dir__, "ext", "build.sh")
end

task default: :test
