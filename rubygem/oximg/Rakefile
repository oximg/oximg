# frozen_string_literal: true

require "rake/testtask"

Rake::TestTask.new(:test) do |t|
  t.libs = %w[lib test]
  t.test_files = FileList["test/**/*_test.rb"]
  t.warning = true
end

# The probe library a platform gem bundles (ext/), built into the
# repo's target/ where the tests look for it. Release, as it ships: the
# tests compare its answers with the executable's.
#
# ext/ has no lock of its own: each build starts from a copy of the
# root Cargo.lock, which cargo prunes to what the library uses, so the
# library always builds the decoders the executable ships. A committed
# lock would drift from the root one, and would refuse --locked builds
# on every version bump.
desc "Build the in-process probe library from ext/"
task :compile do
  root = File.expand_path("../..", __dir__)
  cp File.join(root, "Cargo.lock"), File.join(__dir__, "ext", "Cargo.lock")
  sh "cargo", "build", "--release",
    "--manifest-path", File.join(__dir__, "ext", "Cargo.toml"),
    "--target-dir", File.join(root, "target", "oximg-probe")
end

task default: :test
