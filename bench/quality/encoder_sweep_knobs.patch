+    fn encode_configs_bench() {
+        let dir = std::path::PathBuf::from(std::env::var("OXIMG_ENCODE_BENCH_DIR").unwrap());
+        let q: f32 = std::env::var("OXIMG_ENCODE_BENCH_Q").map_or(80.0, |v| v.parse().unwrap());
+        let mut sets: Vec<_> = std::fs::read_dir(&dir).unwrap().map(|e| e.unwrap().path()).collect();
+        sets.sort();
+        let cfgs: [(&str, bool, X); 7] = [
+            ("P/aq-444", true, X { aq_off: false, opt: false, s420: false }),
+            ("O/aq-444", false, X { aq_off: false, opt: true, s420: false }),
+            ("S/aq-444", false, X { aq_off: false, opt: false, s420: false }),
+            ("P/noaq-444", true, X { aq_off: true, opt: false, s420: false }),
+            ("O/noaq-444", false, X { aq_off: true, opt: true, s420: false }),
+            ("P/aq-420", true, X { aq_off: false, opt: false, s420: true }),
+            ("O/aq-420", false, X { aq_off: false, opt: true, s420: true }),
+        ];
+        for set in sets {
+            let mut paths: Vec<_> = std::fs::read_dir(&set).unwrap().map(|e| e.unwrap().path()).collect();
+            paths.sort();
+            let imgs: Vec<_> = paths.iter().map(|p| read_ppm(p)).collect();
+            let mut line = format!("{:<12} n={:<3}", set.file_name().unwrap().to_string_lossy(), imgs.len());
+            let mut base = 0.0;
+            // Interleave the configurations pass by pass.
+            let mut best = [f64::MAX; 7];
+            for _ in 0..7 {
+                for (k, (_, prog, x)) in cfgs.iter().enumerate() {
+                    let t = std::time::Instant::now();
+                    for (px, w, h) in &imgs {
+                        let mut enc = JpegliEncoder::new_x(*w, *h, q, *prog, *x);
+                        enc.write_scanlines(px).unwrap();
+                        std::hint::black_box(enc.finish());
+                    }
+                    best[k] = best[k].min(t.elapsed().as_secs_f64() * 1e3 / imgs.len() as f64);
+                }
+            }
+            for (k, (name, _, _)) in cfgs.iter().enumerate() {
+                if k == 0 {
+                    base = best[0];
+                    line += &format!("  {name} {:.3} ms", best[0]);
+                } else {
+                    line += &format!("  {name} {:+.1}%", (best[k] / base - 1.0) * 100.0);
+                }
+            }
+            println!("{line}");
+        }
+    }
